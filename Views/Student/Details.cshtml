@model StudentPortal.Models.Student

@{
    ViewData["Title"] = "Student Details";
}

<h2>Student Details</h2>

@if (Model == null)
{
    <p>No student found with this ID.</p>
}
else
{
    <table class="table">
        <tr>
            <th>Id</th>
            <td>@Model.Id</td>
        </tr>
        <tr>
            <th>Name</th>
            <td>@Model.Name</td>
        </tr>
        <tr>
            <th>Age</th>
            <td>@Model.Age</td>
        </tr>
        <tr>
            <th>Course</th>
            <td>@Model.Course</td>
        </tr>
    </table>
}

<a asp-action="AllStudents">Back to All Students</a>